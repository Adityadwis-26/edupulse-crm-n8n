        0,
        1136
      ],
      "webhookId": "3643d2d4-65d3-4f3f-9851-6263ff9bcb24"
    },
    {
      "parameters": {
        "jsCode": "\nconst body = $input.all()[0].json.body || $input.all()[0].json || {};\nconst action = body.action || 'ping';\n\nlet response = {\n  success: true,\n  action: action,\n  timestamp: new Date().toISOString()\n};\n\nif (action === 'create_exam') {\n  const total = Number(body.totalMarks) || 100;\n  const passing = Number(body.passingMarks) || 40;\n  const obtained = (body.marksObtained !== undefined && body.marksObtained !== '' && body.marksObtained !== null) \n    ? Number(body.marksObtained) : null;\n  \n  let grade = null;\n  let percentage = null;\n  let passed = null;\n\n  if (obtained !== null) {\n    percentage = Math.round((obtained / total) * 100 * 10) / 10;\n    passed = obtained >= passing;\n    if (percentage >= 90) grade = 'A+';\n    else if (percentage >= 80) grade = 'A';\n    else if (percentage >= 70) grade = 'B';\n    else if (percentage >= 60) grade = 'C';\n    else if (percentage >= 50) grade = 'D';\n    else grade = 'F';\n  }\n\n  const exam = {\n    id: body.id || ('EX-' + Math.floor(1000 + Math.random() * 9000)),\n    studentId: body.studentId || 'STU-001',\n    studentName: body.studentName || 'Student Name',\n    subject: body.subject || 'General Studies',\n    examTitle: body.examTitle || 'Midterm Assessment',\n    examDate: body.examDate || new Date().toISOString().split('T')[0],\n    totalMarks: total,\n    passingMarks: passing,\n    marksObtained: obtained,\n    percentage: percentage,\n    grade: grade,\n    passed: passed,\n    status: obtained !== null ? 'Graded' : (body.status || 'Scheduled'),\n    feedback: body.feedback || (obtained !== null ? (passed ? 'Cleared successfully' : 'Needs improvement') : 'Pending exam date')\n  };\n\n  response.data = exam;\n  response.message = 'Exam scheduled/recorded successfully in n8n';\n} else if (action === 'record_score') {\n  const total = Number(body.totalMarks) || 100;\n  const passing = Number(body.passingMarks) || 40;\n  const obtained = Number(body.marksObtained) || 0;\n  const percentage = Math.round((obtained / total) * 100 * 10) / 10;\n  const passed = obtained >= passing;\n  \n  let grade = 'F';\n  if (percentage >= 90) grade = 'A+';\n  else if (percentage >= 80) grade = 'A';\n  else if (percentage >= 70) grade = 'B';\n  else if (percentage >= 60) grade = 'C';\n  else if (percentage >= 50) grade = 'D';\n\n  response.data = {\n    id: body.id,\n    studentId: body.studentId,\n    marksObtained: obtained,\n    totalMarks: total,\n    percentage: percentage,\n    grade: grade,\n    passed: passed,\n    status: 'Graded',\n    feedback: body.feedback || (passed ? 'Passed with satisfactory performance' : 'Remedial assessment suggested'),\n    updatedAt: new Date().toISOString()\n  };\n  response.message = 'Score calculated and grade assigned by n8n workflow';\n} else if (action === 'get_summary') {\n  response.data = {\n    status: 'online',\n    workflowName: 'Student Exam Management AI Pipeline',\n    version: '2.0.0',\n    capabilities: ['create_exam', 'record_score', 'ai_tutor', 'analytics']\n  };\n  response.message = 'Workflow connection active and operational';\n} else {\n  response.message = 'Action ' + action + ' received and processed successfully';\n  response.data = body;\n}\n\nconst chatPrompt = body.chatInput || ('Student ' + (response.data?.studentName || 'Student') + ' scored ' + (response.data?.marksObtained || 0) + '/' + (response.data?.totalMarks || 100) + ' in ' + (response.data?.subject || 'Subject') + '. Provide academic evaluation commentary.');\n\nreturn [{ json: { response: response, chatPrompt: chatPrompt, passed: response.data?.passed ?? true } }];\n"
      },
